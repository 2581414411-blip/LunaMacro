                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108"
                android:startColor="#1B2145"
                android:endColor="#0C1024" />
        </aapt:attr>
    </path>

    <!-- 月牙（蓝紫渐变，凸面朝右） -->
    <path android:pathData="M54,24 C72,24 86,38 86,54 C86,70 72,84 54,84 C66,74 72,64 72,54 C72,44 66,34 54,24 Z">
        <aapt:attr name="android:fillColor">
