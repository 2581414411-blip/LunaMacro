                android:endX="86" android:endY="84"
                android:startColor="#6EA8FF"
                android:endColor="#A78BFA" />
        </aapt:attr>
    </path>

    <!-- 星点（左上缺口处） -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M32,26 m-3.2,0 a3.2,3.2 0 1,1 6.4,0 a3.2,3.2 0 1,1 -6.4,0" />
