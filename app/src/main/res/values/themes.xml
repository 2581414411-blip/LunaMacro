<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 应用基础主题：深色，主色蓝 #2563EB。
         Compose 界面通过 NexusAgentTheme 渲染，
         此主题仅用于 Activity 启动时的系统窗口背景，避免白屏闪烁 -->
    <style name="Theme.NexusAgent" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#0F1115</item>
    </style>
</resources>
