      "stable": true
    },
    {
      "id": "REWARD",
      "name": "奖励结算",
      "keywords": ["获得", "点击空白处继续", "领取成功", "确定"],
      "allowedTools": ["click_text", "tap", "click_id", "wait", "press_back"],
      "stable": false
