    { "from": "TASK", "action": "press_back", "to": "HOME" },
    { "from": "REWARD", "action": "click_text:确定", "to": "TASK" },
    { "from": "REWARD", "action": "press_back", "to": "TASK" },
    { "from": "LOADING", "action": "wait", "to": "HOME" },
    { "from": "NET_ERROR", "action": "click_text:重试", "to": "LOADING" }
