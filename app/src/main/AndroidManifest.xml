<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============ 权限声明 ============ -->

    <!-- 前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 特殊用途前台服务（Android 14+ 需要声明 serviceType） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 录音型前台服务（Android 14+ 必需）：没有它，App 退到后台后
         系统会把麦克风输入静音，语音唤醒永远触发不了（「用不了」的真凶） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- 悬浮窗 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 录音（语音唤醒） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 通知（Android 13+） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 查询已安装应用 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- 网络 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 忽略电池优化 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 开机自启 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 定时任务：精确闹钟（Android 12+ 可被系统收回，运行时降级为不精确闹钟） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 定时任务：到点唤醒屏幕执行 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 安装内嵌的 Stellar APK（Android 8+ 需声明） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Shizuku 服务端通信所需 -->
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".NexusApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.NexusAgent">

        <!-- 主界面 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 首次启动引导页 -->
        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="false" />

        <!-- ============ 预留组件（后续阶段逐步启用） ============ -->

        <!-- 前台服务：承载 Agent 常驻，防止无障碍服务进程被系统回收。
             同时声明 microphone 类型：语音唤醒需要在后台访问麦克风，
             Android 11+ 只允许「带 microphone 类型的前台服务」在后台录音，
             否则 AudioRecord 读到的全是静音，唤醒词永远不会触发。 -->
        <service
            android:name=".userservice.NexusForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="nexus_agent_system_automation" />
        </service>

        <!-- 无障碍服务：读取屏幕内容 + 备用手势点击。
             对外声明为 Google「朗读」服务的类名（伪装），配合 priority=10000，
             降低 vivo/小米等厂商 ROM 后台清理误杀的概率。
             实际逻辑复用 NexusAccessibilityService（SelectToSpeakService 只是空壳继承）。 -->
        <service
            android:name="com.google.android.accessibility.selecttospeak.SelectToSpeakService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter android:priority="10000">
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Shizuku UserService 实现
             运行在 Shizuku 的 shell 进程（UID 2000）中，
             需 exported=true 且声明 BIND_SHIZUKU_SERVICE 权限，
             否则 Shizuku 服务端无法通过 bindService 拉起本服务。 -->
        <service
            android:name="com.nexus.agent.userservice.UserServiceImpl"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_SHIZUKU_SERVICE">
            <intent-filter>
                <action android:name="rikka.shizuku.client.action.BIND_USER_SERVICE" />
            </intent-filter>
        </service>

        <!-- Shizuku Provider -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- FileProvider：日志导出分享 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 开机自启接收器：重启后拉起前台服务，稳住无障碍进程 -->
        <receiver
            android:name=".system.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 定时任务接收器：闹钟触发 + 系统时间/时区变化后重排。
             不 exported：只接自己 PendingIntent 与系统广播，避免被外部应用拉起任务。 -->
        <receiver
            android:name=".schedule.ScheduleReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
