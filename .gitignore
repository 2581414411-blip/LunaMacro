*.iml
.gradle/
local.properties
.idea/
build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
app/release/

# 内嵌的 Stellar APK 是部署资源，必须进版本库（例外于上面的 *.apk）
!app/src/main/assets/stellar.apk

# KWS 训练数据与产物（音频/模型是二进制生成物，不纳入版本库）
kws/data/
kws/tmp/
kws/raw/
kws/output/
kws/venv/

# 游戏画面 SFT 训练数据与产物（截图/标注/JSONL 是数据，不纳入版本库）
train/dataset/
train/output/

# Release 签名（keystore 与密码文件不进版本控制）
*.keystore
*.jks
keystore.properties

# 临时检查报告，不入版本控制
VOICE_ASSISTANT_STATUS.md

# 本地测试临时文件（WiFi 调试地址、日志）
adb_wifi.txt
logs/

# 大模型文件（本地视觉 Qwen2-VL-2B 1.3GB + SenseVoice 229MB）
# 体积过大不入 Git，运行时缺失会自动降级云端/离线；
# 如需本地模型，从 Release 单独下载后放入对应目录
app/src/main/assets/models/
app/src/main/assets/sensevoice/

# 废弃的旧唤醒词模型（已被 sherpa-onnx KWS 替代）
app/src/main/assets/nexus_kws.onnx

# 瘦身构建时临时移出的模型目录（1.3GB，绝不能进 git）
app/_hold_models/
app/_hold_sensevoice/
